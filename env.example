# --- Terjemahan ---
TRANSLATOR_BACKEND=google          # google (gratis, tanpa API key) | claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5  # jika pakai claude

# --- Speech-to-text ---
WHISPER_MODEL=small                # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto                # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto          # auto | int8 | float16 | int8_float16
WHISPER_MODEL_DIR=./data/models

# --- Aplikasi ---
DATA_DIR=./data
MAX_UPLOAD_MB=2048
MAX_CONCURRENT_JOBS=1              # transkripsi berat, default 1 job sekaligus
CORS_ORIGINS=http://localhost:5173
FILE_RETENTION_HOURS=72            # job lama dihapus otomatis
